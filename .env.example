
# ============================================
# Hybrid Agentic RAG - Environment Configuration
# ============================================

# Local Ollama inference
OLLAMA_BASE_URL=http://localhost:11434

# LLM and embedding models
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional local LLM judge
JUDGE_MODEL=llama3.2:3b

# LangSmith tracing (disabled for local use)
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# ============================================
# Optional Cloud API Configuration
# ============================================
# These are NOT required for the local pipeline.
# Only configure them if using cloud models.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=
# GROQ_API_KEY=
# LANGSMITH_API_KEY=
